{
  "name": "api-gateway-rate-limiter",
  "version": "0.1.0",
  "description": "Reference implementation of a small API gateway: rate limiting (token bucket, sliding window), circuit breaker, bounded retries, Prometheus metrics.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hardyal Singh Deora <hardyalsinghdeora@gmail.com>",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "demo:upstream": "tsx scripts/demo-upstream.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
